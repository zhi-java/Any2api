{
  "name": "zhi2api",
  "version": "1.0.0",
  "description": "zhi2Api multi-channel web-to-API proxy",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "undici": "^6.21.2"
  },
  "displayName": "zhi2Api",
  "pkg": {
    "assets": [
      "src/admin/**/*",
      "src/performance/**/*",
      "src/sha3_wasm_bg.wasm",
      ".env.example"
    ],
    "scripts": [
      "src/*.js",
      "src/channels/**/*.js",
      "src/core/**/*.js",
      "src/middleware/**/*.js",
      "src/protocols/**/*.js",
      "src/routes/**/*.js",
      "src/services/**/*.js",
      "src/utils/**/*.js"
    ]
  },
  "files": [
    "src",
    "README.md",
    ".env.example"
  ],
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  }
}
