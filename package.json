{
  "name": "omni",
  "version": "1.0.0",
  "description": "OmniAPI multi-channel web-to-API proxy",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "build": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "undici": "^6.21.2"
  },
  "displayName": "OmniAPI",
  "files": [
    "src",
    "README.md",
    ".env.example"
  ]
}
