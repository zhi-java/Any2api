{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniAPI",
  "version": "0.1.0",
  "identifier": "com.omniapi.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/prepare-core.mjs --force"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OmniAPI",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "resources": [
      "resources/core/**/*",
      "resources/node/**/*",
      "resources/README.txt",
      "resources/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "shortDescription": "本地 AI 网关桌面控制台",
    "longDescription": "OmniAPI Desktop：托盘控制台 + 首启向导 + 本机 Core 生命周期管理。安装包内含 Core 二进制，无需本机 Node。"
  },
  "plugins": {}
}
