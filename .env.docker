# Docker 环境配置示例
# 复制此文件为 .env 并根据实际需求修改

# DeepSeek 认证（至少配置一种，token 优先加载）
# DS_TOKEN=
# DS_TOKENS=
DS_ACCOUNTS=
# DS_ACCOUNTS_EXTENDED=

# 启动层变量（容器内通常保持 3000，宿主机端口在 docker-compose.yml 中配置）
PORT=3000
# ZHI2API_DATA_DIR=/data

# 出站代理（可选）
HTTPS_PROXY=
HTTP_PROXY=

# 本服务管理后台 Key 与旧版外部 API Key（生产环境务必设置）
API_KEY=sk-zhi
# API_KEYS=

# 服务行为（可在管理后台“配置”页面维护）
MERGE_THINKING=false
ENABLE_PROMPT_INJECTION=true
SYSTEM_FINGERPRINT=fp_omni_v1

# 日志（Docker 中默认写入 /app/logs 并通过 volume 持久化）
LOG_DIR=/app/logs
CLIENT_DEBUG_LOG=false
# CLIENT_DEBUG_LOG_DIR=/app/logs-debug
CLIENT_DEBUG_LOG_MAX_CHARS=200000

# DeepSeek Token 池调优
MAX_CONCURRENT_PER_TOKEN=2
TOKEN_DEAD_THRESHOLD=5
HEALTH_CHECK_INTERVAL=600
IDLE_THRESHOLD=1800
DEEPSEEK_VALIDATE_ON_STARTUP=false
DEEPSEEK_PREWARM_SESSIONS=false
DEEPSEEK_CONTEXT_FALLBACK=true
DEEPSEEK_PRO_SAFE_INPUT_TOKENS=110000

# 会话管理与对话亲和
SESSION_TTL=1800
MAX_REQUESTS_PER_SESSION=8
ENABLE_CONVERSATION_AFFINITY=false
CONVERSATION_TTL_MS=1800000
MAX_CONVERSATIONS=500
MAX_TURNS_PER_SESSION=10

# 工具调用容错
ENABLE_FC_ERROR_RETRY=true
FC_ERROR_RETRY_MAX_ATTEMPTS=3

# GLM 认证
GLM_REFRESH_TOKEN=
# GLM_REFRESH_TOKENS=
GLM_GUEST_MODE=true

