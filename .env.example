# ============================================================
# OmniAPI 部署配置示例
#
# 复制为 .env 后，只需填写下面几项；其余参数均有内置默认值，
# 可在管理后台「设置」页面调整（会持久化，无需改本文件）。
# ============================================================

# ---------- 上游认证（二选一）----------
# 方式一：账号密码，逗号分隔（推荐，token 失效时自动重新登录）
#   格式：邮箱:密码,邮箱:密码
DS_ACCOUNTS=
# 方式二：直接给 token，逗号分隔（token 失效后需手工更换）
#   多个 token：token1,token2
DS_TOKENS=

# ---------- 服务端口 ----------
PORT=3000

# ---------- 管理后台 Key（同时用作 API 请求 Key，请妥善保管）----------
API_KEY=sk-zhi
