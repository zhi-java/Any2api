# DeepSeek 认证（至少配置一种，token 优先加载）
# 单个 token
# DS_TOKEN=
# 多个 token，逗号分隔（优先于 DS_TOKEN）
# DS_TOKENS=
# 账号登录，格式：email:password,email:password（自动登录获取/刷新 token）
DS_ACCOUNTS=
# 已有 token 与账号关联，格式：email:password:token_prefix,email:password:token_prefix
# token_prefix 为 token 的前 12 个字符，用于将 .env 中的 token 关联到对应账号以便自动刷新
# DS_ACCOUNTS_EXTENDED=

# 启动层变量（修改后需要重启）
PORT=3000
# ZHI2API_ENV_PATH=
# ZHI2API_CONFIG_PATH=
# ZHI2API_DATA_DIR=

# 出站代理（可选，修改后建议重启）
HTTPS_PROXY=
HTTP_PROXY=

# 本服务管理后台 Key 与旧版外部 API Key（生产环境务必设置）
API_KEY=sk-zhi
# 新版外部 API Key 列表，建议在管理后台 API Keys 页面维护
# API_KEYS=sk-omni-xxx,sk-omni-yyy

# 服务行为（可在管理后台“配置”页面维护）
MERGE_THINKING=false
ENABLE_PROMPT_INJECTION=true
SYSTEM_FINGERPRINT=fp_omni_v1

# 日志（可在管理后台“配置”页面维护）
LOG_DIR=logs
CLIENT_DEBUG_LOG=false
# CLIENT_DEBUG_LOG_DIR=logs-debug
CLIENT_DEBUG_LOG_MAX_CHARS=200000

# DeepSeek Token 池调优（可在管理后台“上游凭据/配置”维护）
MAX_CONCURRENT_PER_TOKEN=2
TOKEN_DEAD_THRESHOLD=5
HEALTH_CHECK_INTERVAL=600
IDLE_THRESHOLD=1800
DEEPSEEK_VALIDATE_ON_STARTUP=false
DEEPSEEK_PREWARM_SESSIONS=false
# 上报给客户端的缓存命中率（%）。上游 Web 接口不提供 prompt cache 统计，
# 该值仅用于客户端展示，不影响计费；上游若直接提供则以真实值为准。
DEEPSEEK_REPORTED_CACHE_HIT_RATE=98.5
# 对外上报的上下文窗口与最大输出（tokens），客户端据此自动识别模型能力。
# 默认取 DeepSeek 官方 1M 规范：1M 上下文。
DEEPSEEK_CONTEXT_LENGTH=1048576
DEEPSEEK_MAX_OUTPUT_TOKENS=65536

# 会话管理与对话亲和（可在管理后台“配置”页面维护）
SESSION_TTL=1800
ENABLE_CONVERSATION_AFFINITY=false
CONVERSATION_TTL_MS=1800000
MAX_CONVERSATIONS=500

# 工具调用容错（可在管理后台“配置”页面维护）
ENABLE_FC_ERROR_RETRY=true
