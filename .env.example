# ============================================================
# OmniAPI 部署配置示例
#
# 复制为 .env 后，只需填写下面几项；其余参数均有内置默认值，
# 可在管理后台「设置」页面调整（会持久化，无需改本文件）。
# ============================================================

# ---------- 上游认证（二选一）----------
# 方式一：账号密码，逗号分隔（推荐，token 失效时自动重新登录）
#   格式：邮箱:密码,邮箱:密码
DS_ACCOUNTS=
# 方式二：直接给 token，逗号分隔（token 失效后需手工更换）
#   多个 token：token1,token2
DS_TOKENS=

# ---------- 服务端口 ----------
PORT=3000

# ---------- 管理后台 Key（同时用作 API 请求 Key，请妥善保管）----------
API_KEY=sk-zhi

# ============================================================
# 以下为可选项，默认值已针对低配服务器调优，通常无需修改。
# ============================================================

# ---------- 内存护栏 ----------
# V8 堆上限。显式限制可让 GC 更早介入，避免进程被宿主 OOM Killer 静默杀掉
# （被杀时没有任何日志，最难排查）。建议设为容器内存上限的 60%~75%。
# NODE_OPTIONS=--max-old-space-size=512

# 请求体上限（MB）。过大在并发时会显著放大内存占用。
# MAX_REQUEST_BODY_MB=25

# 单次响应在内存中的捕获上限（字符，默认 262144 = 256KB）。
# 超限后日志只记录元数据 + 截断正文，避免长回复把整段内容留在内存。
# 设为 0 表示完全不捕获响应体（最省内存，但日志无响应内容）。
# LOG_RESPONSE_CAPTURE_MAX_CHARS=262144

# 近期日志在内存中保留的条数（日志页最多展示 200 条）。
# LOG_MEMORY_LIMIT=300

# 排队请求上限。超过后新请求快速失败，避免无意义的长等待。
# QUEUE_MAX_SIZE=50

# ---------- 客户端调试日志（排障用，默认关闭）----------
# 记录完整请求/响应正文（含对话内容），是磁盘增长最快的部分（实测单日 37MB）。
# 仅在排查协议/解析问题时临时开启，用完请关闭。
# CLIENT_DEBUG_LOG=false
# 单字段记录上限（字符），默认 65536
# CLIENT_DEBUG_LOG_MAX_CHARS=65536
# 单日文件大小上限（字节），默认 20MB；达到后暂停写入并告警
# CLIENT_DEBUG_LOG_MAX_BYTES=20971520
# 调试日志保留天数，启动时自动清理更早的文件
# CLIENT_DEBUG_LOG_KEEP_DAYS=7
