# DeepSeek 认证（至少配置一种，token 优先加载）
# 单个 token
# DS_TOKEN=
# 多个 token，逗号分隔（优先于 DS_TOKEN）
# DS_TOKENS=
# 账号登录，格式：email:password,email:password（自动登录获取/刷新 token）
DS_ACCOUNTS=
# 已有 token 与账号关联，格式：email:password:token_prefix,email:password:token_prefix
# token_prefix 为 token 的前 12 个字符，用于将 .env 中的 token 关联到对应账号以便自动刷新
#DS_ACCOUNTS_EXTENDED=

# 服务端口
PORT=3000

# 出站代理（可选）
# 支持 HTTPS_PROXY / HTTP_PROXY 及其小写变体 https_proxy / http_proxy
# 一旦配置代理，启动时会强制初始化；若代理不可用或依赖缺失，服务会直接退出
HTTPS_PROXY=
HTTP_PROXY=

# 本服务 API Key 鉴权（可选，留空则不鉴权）
# 生产环境务必设置；/admin 页面可打开，管理与性能 API 需要此 Key
API_KEY=sk-zhi

# Token 池调优（可选，括号内为默认值）
MAX_CONCURRENT_PER_TOKEN=2     # 每个 token 的并发请求上限
TOKEN_DEAD_THRESHOLD=5         # 连续错误达到该次数后将 token 标记为不可用
HEALTH_CHECK_INTERVAL=600      # 健康检查间隔（秒）
IDLE_THRESHOLD=1800            # 仅检查空闲超过此时长的 token（秒）

# 会话管理调优（可选，括号内为默认值）
SESSION_TTL=1800               # 会话缓存有效期（秒），过期后创建新会话
MAX_REQUESTS_PER_SESSION=8     # 单个会话最大请求数，超过后轮换新会话以避免触发 DeepSeek 编辑/续写限制

# 日志（可选）
# 日志根目录；未设置时默认写入项目下的 logs 目录
LOG_DIR=/data
# 客户端完整调试日志（默认关闭）：记录脱敏请求头、原始请求体、对外响应体、SSE 统计与解析出的正文/思考
CLIENT_DEBUG_LOG=false
# 调试日志目录；未设置时跟随 LOG_DIR，写入 <dir>/zhi2api/client-debug/YYYY-MM-DD.jsonl
# CLIENT_DEBUG_LOG_DIR=logs-debug
# 单字段最大记录字符数，防止超大响应撑爆日志
CLIENT_DEBUG_LOG_MAX_CHARS=200000

# 输出格式（可选，默认 false）
# 设为 true 后，thinking 内容会合并进 content 字段，并使用 <think> 标签包裹
# 默认 false：thinking 作为独立的 reasoning_content 字段返回，兼容 Claude Code、OpenAI 客户端
MERGE_THINKING=false

# 提示词注入开关（可选，默认 true）
# true 或未配置：保持现有 DeepSeek/GLM/Kimi/Qwen Web 上游，并在启用工具时注入动态 trigger + <function_calls> XML 工具说明。
# false/0/no/off：仍使用现有 Web 上游、认证、上传、队列和流解析，
# 但不再添加 Any2api 自己的角色标签、工具说明、工具结果续写说明等提示词；
# 发给 Web 上游的 prompt 为客户端请求体的完整 JSON 文本，且模型输出不会被解析成协议级 tool_calls。
ENABLE_PROMPT_INJECTION=true

# 对话亲和 / 多轮续接（可选，默认关闭）
# 启用后，客户端传 X-Conversation-Id 头（或缺省时按 messages 哈希自动派生），
# 同一对话会被路由到固定的 DeepSeek 会话，并通过 parent_message_id 续接：
# 上游每轮只收到最新一条用户消息，历史由 DeepSeek 服务端维护，
# 从而避免把完整历史拍平成文本导致的角色混淆，并显著减少上游额度消耗。
# 关闭（默认）时行为完全不变：每轮发送完整历史，parent_message_id 为 null。
ENABLE_CONVERSATION_AFFINITY=false
CONVERSATION_TTL_MS=1800000      # 对话空闲多久后回收（毫秒，默认 30 分钟）
MAX_CONVERSATIONS=500            # 内存中同时保留的对话数上限
MAX_TURNS_PER_SESSION=10         # 单个 DeepSeek 会话续接轮数上限，超过自动轮换新会话

# GLM（智谱清言）认证（可选，留空则使用访客模式）
# 访客模式：无需配置，自动获取临时 token
# 长期模式：配置 refresh_token 以保持长期访问
# 获取方式：参考 docs/GLM模型调用接入指南.md
GLM_REFRESH_TOKEN=

# Qwen 认证（可选，使用 Qwen 渠道时必填）
# 多个 bearer token，逗号分隔
# QWEN_TOKENS=
# 账号登录，格式：email:password,email:password（自动登录获取/刷新 token）
# QWEN_ACCOUNTS=

# Qwen 队列/并发调优（可选，未设置时使用通用项或默认值）
# QWEN_MAX_CONCURRENT_PER_TOKEN=1
# QWEN_MAX_QUEUE_SIZE=100
# QWEN_QUEUE_TIMEOUT_MS=30000
# QWEN_ACCOUNT_MIN_INTERVAL_MS=1200
# QWEN_RATE_LIMIT_BASE_COOLDOWN_MS=600000
# QWEN_RATE_LIMIT_MAX_COOLDOWN_MS=3600000
# QWEN_MAX_TOKEN_ERRORS=3

# Kimi 认证（可选，使用 Kimi 渠道时必填）
# 单个 token
# KIMI_AUTH_TOKEN=
# 多个 token，逗号分隔（优先于 KIMI_AUTH_TOKEN）
# KIMI_AUTH_TOKENS=
# 长文本自动作为 txt 附件上传的阈值（字节，默认 450000）
# KIMI_TEXT_ATTACHMENT_THRESHOLD_BYTES=450000
